{
  "actorSpecification": 1,
  "name": "komehyo-japan-brand-scraper",
  "title": "Komehyo Japan Luxury Resale Scraper",
  "version": "0.0.1",
  "buildTag": "latest",
  "input": "./INPUT_SCHEMA.json",
  "dockerfile": "./Dockerfile",
  "outputSchema": {
    "actorOutputSchemaVersion": 1,
    "title": "Komehyo Products",
    "description": "Scraped product data from Komehyo search results.",
    "type": "object",
    "properties": {
      "productId": {
        "type": "string",
        "description": "Product ID",
        "template": "{{productId}}"
      },
      "title": {
        "type": "string",
        "description": "Product title",
        "template": "{{title}}"
      },
      "brand": {
        "type": "string",
        "description": "Brand name",
        "template": "{{brand}}"
      },
      "price": {
        "type": "string",
        "description": "Tax included price in JPY",
        "template": "{{price}}"
      },
      "referencePrice": {
        "type": "string",
        "description": "Reference retail price in JPY (nullable)",
        "template": "{{referencePrice}}"
      },
      "rank": {
        "type": "string",
        "description": "Condition rank, e.g. 中古品A",
        "template": "{{rank}}"
      },
      "size": {
        "type": "string",
        "description": "Item size",
        "template": "{{size}}"
      },
      "material": {
        "type": "string",
        "description": "Material",
        "template": "{{material}}"
      },
      "store": {
        "type": "string",
        "description": "Stock store",
        "template": "{{store}}"
      },
      "imageUrl": {
        "type": "string",
        "description": "Product image URL",
        "template": "{{imageUrl}}"
      },
      "productUrl": {
        "type": "string",
        "description": "Product page URL",
        "template": "{{productUrl}}"
      },
      "scrapedAt": {
        "type": "string",
        "description": "Scrape timestamp in ISO 8601",
        "template": "{{scrapedAt}}"
      }
    },
    "required": ["productId", "title", "productUrl"]
  }
}
